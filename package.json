{
  "name": "n8n-nodes-google-photos",
  "version": "0.1.0",
  "description": "n8n community node for Google Photos — direct Library API and Picker API integration",
  "license": "MIT",
  "keywords": ["n8n-community-node-package", "google-photos"],
  "main": "dist/nodes/GooglePhotos/GooglePhotos.node.js",
  "types": "dist/nodes/GooglePhotos/GooglePhotos.node.d.ts",
  "files": ["dist"],
  "scripts": {"build": "tsc -p tsconfig.json", "dev": "tsc -p tsconfig.json --watch", "lint": "eslint nodes credentials --ext .ts", "test": "vitest run"},
  "n8n": {"n8nNodesApiVersion": 1, "credentials": ["dist/credentials/GooglePhotosOAuth2Api.credentials.js"], "nodes": ["dist/nodes/GooglePhotos/GooglePhotos.node.js"]},
  "engines": {"node": ">=20.0.0"},
  "dependencies": {"n8n-workflow": "^1.120.0"},
  "devDependencies": {"@types/node": "^22.0.0", "eslint": "^9.0.0", "typescript": "^5.7.0", "vitest": "^3.0.0"}
}
